{
  "version": 1,
  "source": "https://www.globalsponsorhub.com/sitemap.xml",
  "routes": [
    { "pattern": "^/$", "mode": "native", "target": "/(tabs)/home" },
    { "pattern": "^/(?:auth/)?login/?$", "mode": "native", "target": "/login" },
    { "pattern": "^/auth/register(?:/candidate)?/?$", "mode": "native", "target": "/register" },
    { "pattern": "^/(?:auth/)?verify(?:-otp)?/?$", "mode": "native", "target": "/verify" },
    { "pattern": "^/jobs/?$", "mode": "native", "target": "/(tabs)/jobs" },
    { "pattern": "^/candidate/jobs/?$", "mode": "native", "target": "/(tabs)/jobs" },
    { "pattern": "^/jobs/external/?$", "mode": "native", "target": "/curated-listings" },
    { "pattern": "^/jobs/country/(australia|canada|germany|ireland|netherlands|new-zealand|singapore|switzerland|uae|uk|usa)/?$", "mode": "native", "target": "/country/$1" },
    { "pattern": "^/jobs/([a-f0-9]{24})/?$", "mode": "native", "target": "/job/$1" },
    { "pattern": "^/candidate/apply/([a-f0-9]{24})/?$", "mode": "native", "target": "/job/$1" },
    { "pattern": "^/candidate/job-details/?$", "mode": "native-query", "target": "/job/{id|job}" },
    { "pattern": "^/candidate/my-jobs/?$", "mode": "native", "target": "/(tabs)/applications" },
    { "pattern": "^/(?:candidate/job-alerts|alerts)/?$", "mode": "native", "target": "/alerts" },
    { "pattern": "^/(?:candidate/job-matches|job-matches|matches)/?$", "mode": "native", "target": "/alerts" },
    { "pattern": "^/(?:candidate/notifications?|notifications?|notification-feed)/?$", "mode": "native", "target": "/notification-feed" },
    { "pattern": "^/(?:candidate/)?(?:benefits?|relocation-perks)/?$", "mode": "native", "target": "/relocation-perks" },
    { "pattern": "^/candidate/employer-follows/?$", "mode": "native", "target": "/employer-follows" },
    { "pattern": "^/(?:candidate/)?saved(?:-jobs)?/?$", "mode": "native", "target": "/saved" },
    { "pattern": "^/(?:candidate/)?messages/?$", "mode": "native-query", "target": "/conversation/{conversationId|conversation|thread}", "defaultTarget": "/(tabs)/messages" },
    { "pattern": "^/conversation/([^/]+)/?$", "mode": "native", "target": "/conversation/$1" },
    { "pattern": "^/resources/?$", "mode": "native", "target": "/resources" },
    { "pattern": "^/resources/articles/([^/]+)/?$", "mode": "native", "target": "/resources/articles/$1" },
    { "pattern": "^/resources/(visa-sponsorship-cover-letter-template|employer-verification-email-template|job-offer-scam-checklist|relocation-budget-checklist|first-90-days-relocation-checklist|visa-sponsorship-interview-questions|international-application-tracker-template)/?$", "mode": "native", "target": "/resources/$1" },
    { "pattern": "^/resources/.+", "mode": "fallback" },
    { "pattern": "^/candidate/resources/?$", "mode": "native", "target": "/resources" },
    { "pattern": "^/candidate/saved-resources/?$", "mode": "native", "target": "/saved-resources" },
    { "pattern": "^/candidate/application-tracker/?$", "mode": "native", "target": "/application-tracker" },
    { "pattern": "^/candidate/profile(?:/edit)?/?$", "mode": "native", "target": "/(tabs)/profile" },
    { "pattern": "^/candidate/settings/?$", "mode": "native", "target": "/settings" },
    { "pattern": "^/candidate/offers/?$", "mode": "native", "target": "/offers" },
    { "pattern": "^/candidate/feedback/?$", "mode": "native", "target": "/feedback" },
    { "pattern": "^/candidate/profile/extraction-review/?$", "mode": "native", "target": "/profile-extraction-review" },
    { "pattern": "^/relocation-help/?$", "mode": "native", "target": "/relocation-help" },
    { "pattern": "^/candidate/move-support/?$", "mode": "native", "target": "/relocation-help" },
    { "pattern": "^/relocation-help/requests/([a-f0-9]{24})/?$", "mode": "native", "target": "/relocation-help/$1" },
    { "pattern": "^/(?:candidate/move-support|plan-the-move)/requests/([a-f0-9]{24})/?$", "mode": "native", "target": "/relocation-help/$1" },
    { "pattern": "^/candidate/agency-introductions/?$", "mode": "native", "target": "/agency-introductions" },
    { "pattern": "^/candidate/agency-introductions/([a-f0-9]{24})/?$", "mode": "native", "target": "/agency-introductions/$1" },
    { "pattern": "^/companies/?$", "mode": "native", "target": "/companies" },
    { "pattern": "^/companies/([^/]+)/?$", "mode": "native", "target": "/company/$1" },
    { "pattern": "^/partners/directory/?$", "mode": "native", "target": "/partners" },
    { "pattern": "^/partners/directory/([a-f0-9]{24})/?$", "mode": "native", "target": "/partner/$1" },
    { "pattern": "^/blog/?$", "mode": "native", "target": "/blog" },
    { "pattern": "^/blog/feed\\.xml/?$", "mode": "fallback" },
    { "pattern": "^/blog/([^/]+)/?$", "mode": "native", "target": "/blog/$1" },
    { "pattern": "^/(?:guides|countries)/?$", "mode": "native", "target": "/countries" },
    { "pattern": "^/trust/how-we-label-jobs/?$", "mode": "native", "target": "/trust/how-we-label-jobs" },
    { "pattern": "^/relocating/(relocating-family-visas-move-with-job|regulated-jobs-credentials-recognition-abroad|remote-jobs-visa-requirements|remote-friendly-globally-remote-sponsor-friendly|questions-before-remote-international-job)/?$", "mode": "native", "target": "/relocating/$1" },
    { "pattern": "^/(visa-sponsorship-jobs|global-relocation-directory|best-visa-sponsorship-job-sites)/?$", "mode": "native", "target": "/guide/$1" },
    { "pattern": "^/guides/country/([^/]+)/?$", "mode": "native", "target": "/guides/country/$1" },
    { "pattern": "^/guides/.+", "mode": "fallback" },
    { "pattern": "^/global-news/?$", "mode": "native", "target": "/news" },
    { "pattern": "^/faqs?/?$", "mode": "native", "target": "/faq" },
    { "pattern": "^/contact/?$", "mode": "native", "target": "/contact" },
    { "pattern": "^/compare-countries/?$", "mode": "native", "target": "/compare-countries" },
    { "pattern": "^/plan-the-move/?$", "mode": "native", "target": "/relocation-help" },
    { "pattern": "^/tools/visa-wizard/?$", "mode": "native", "target": "/relocation-help" },
    { "pattern": "^/tools/visa-checker/?$", "mode": "native", "target": "/companies" },
    { "pattern": "^/tools/currency-converter/?$", "mode": "native", "target": "/currency-converter" },
    { "pattern": "^/tools/relocation-worksheets/?$", "mode": "native", "target": "/relocation-worksheets" },
    { "pattern": "^/candidate/tools/?$", "mode": "native", "target": "/tools" },
    { "pattern": "^/candidate/tools/cv-quality/?$", "mode": "native", "target": "/cv-quality-checker" },
    { "pattern": "^/learn(?:/.*)?$", "mode": "native", "target": "/tools-resources" },
    { "pattern": "^/privacy-policy/?$", "mode": "native", "target": "/legal/privacy-policy" },
    { "pattern": "^/(?:terms|terms-and-conditions)/?$", "mode": "native", "target": "/legal/terms-and-conditions" },
    { "pattern": "^/cookie-policy/?$", "mode": "native", "target": "/legal/cookie-policy" },
    { "pattern": "^/acceptable-use/?$", "mode": "native", "target": "/legal/acceptable-use" },
    { "pattern": "^/legal/?$", "mode": "native", "target": "/legal" },
    { "pattern": "^/(?:specialists|plan-the-move)(?:/.*)?$", "mode": "fallback" },
    { "pattern": "^/matching-explained/?$", "mode": "native", "target": "/legal/matching-explained" },
    { "pattern": "^/(?:employer-talent-access-terms|provider-lead-terms|affiliate-terms|payment-terms)/?$", "mode": "fallback" },
    { "pattern": "^/(?:relocating|countries|seo|trust)(?:/.*)?$", "mode": "fallback" },
    { "pattern": "^/(?:about|candidates|employers|partners|pricing|agencies|agencies-recruiters|how-it-works|account-deletion)(?:/.*)?$", "mode": "fallback" },
    { "pattern": "^/grow-your-network(?:/.*)?$", "mode": "fallback" },
    { "pattern": "^/(?:discussions|expert-insights)(?:/.*)?$", "mode": "fallback" }
  ]
}
