# Copy to `.env` for local dev. EAS: set the same names as project secrets / env on build profiles.

# Blog (same Supabase project as global_sponsor_hub-fe — see that repo’s NEXT_PUBLIC_SUPABASE_*)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional overrides (defaults exist in app.config.js `expo.extra`)
# EXPO_PUBLIC_API_URL=https://api.globalsponsorhub.com
# EXPO_PUBLIC_SITE_URL=https://www.globalsponsorhub.com

# Candidate signup when API enforces Turnstile bypass via mobile key
EXPO_PUBLIC_GSH_MOBILE_REGISTRATION_KEY=
